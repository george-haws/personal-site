{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npm run build && wrangler dev --var ANALYTICS_PROVIDER:none",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p worker",
    "types": "wrangler types worker/worker-configuration.d.ts --strict-vars=false",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "npm run check && npm run test:e2e && wrangler deploy",
    "resume": "tsx scripts/build-resume.ts",
    "audit:responsive": "tsx scripts/audit-responsive.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.48.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.1",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  }
}
