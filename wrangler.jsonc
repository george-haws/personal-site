{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Pages and the PDF run the Worker; Next's RSC payloads, icons, and crawler files stay asset-first and free.
    "run_worker_first": ["/*", "!/_next/*", "!/*.txt", "!/*.ico", "!/*.png", "!/*.svg", "!/*.xml"]
  },
  "vars": {
    // "umami" or "none". The Worker disables tracking when the website ID is empty.
    "ANALYTICS_PROVIDER": "umami",
    "UMAMI_WEBSITE_ID": ""
  }
}
